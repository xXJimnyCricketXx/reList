# Kopieren nach .env und ausfüllen. Die .env nie committen.
REBUY_EMAIL=deine@email.de
REBUY_PASSWORD=dein-rebuy-passwort

# Optional
# OWNER_NAME=Max              # Überschrift: "Wunschliste von Max"
# STALE_MINUTES=5            # Seitenaufruf holt frisch, wenn der Stand älter ist
# REFRESH_INTERVAL_HOURS=6   # Abgleich im Hintergrund
# TZ=Europe/Berlin
# PUID=1000                  # Besitzer der Dateien in data/ (Unraid: 99)
# PGID=1000                  # (Unraid: 100)
